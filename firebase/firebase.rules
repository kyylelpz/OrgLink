rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validStudent(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.fullName.matches('.*[^ ].*')
        && data.studentNumber is string && data.studentNumber.matches('^[A-Za-z0-9][A-Za-z0-9-]{2,29}$')
        && data.yearLevel is int && data.yearLevel >= 1 && data.yearLevel <= 6
        && data.section is string && data.section.matches('^[A-Za-z0-9][A-Za-z0-9 -]{0,29}$');
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.auth.token.email is string
        && request.resource.data.keys().hasAll(['uid','email','fullName','studentNumber','yearLevel','section','photoURL','platformRole','accountStatus','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['uid','email','fullName','studentNumber','yearLevel','section','photoURL','platformRole','accountStatus','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.platformRole == 'user'
        && request.resource.data.accountStatus == 'active'
        && (request.resource.data.photoURL == null || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && validStudent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','studentNumber','yearLevel','section','updatedAt'])
        && validStudent(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // Listing, deletion, privileged fields and other users' data are denied.
    }
    function eligible() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
        && validStudent(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }
    function organization(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)).data; }
    function manager(orgId) { return eligible() && organization(orgId).managerUid == request.auth.uid; }
    function activeMember(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.membershipStatus == 'active';
    }
    function rosterReader(orgId) {
      return manager(orgId) || (eligible() && activeMember(orgId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.permissions.viewRoster == true);
    }
    function attendanceOperator(orgId) {
      return eligible() && (organization(orgId).managerUid == request.auth.uid
        || (activeMember(orgId)
          && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.membershipRole == 'officer'
          && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.permissions.get('manageAttendance',false) == true));
    }
    function accessibleOrganization(orgId) {
      return eligible() && ((organization(orgId).visibility == 'public' && organization(orgId).status == 'active')
        || organization(orgId).managerUid == request.auth.uid || activeMember(orgId));
    }
    match /organizations/{orgId} {
      allow get: if accessibleOrganization(orgId);
      allow list: if eligible() && ((resource.data.visibility == 'public' && resource.data.status == 'active')
        || resource.data.managerUid == request.auth.uid);
      // Organization creation, configuration, manager assignment and role grants
      // are administrative operations; no client writes are permitted.
      match /memberships/{uid} {
        allow get: if eligible() && (owner(uid) || manager(orgId)
          || (rosterReader(orgId) && resource.data.membershipStatus == 'active'));
        allow list: if manager(orgId) || (rosterReader(orgId) && resource.data.membershipStatus == 'active');
        allow create: if eligible() && owner(uid)
          && organization(orgId).visibility == 'public' && organization(orgId).status == 'active'
          && organization(orgId).managerUid != request.auth.uid
          && organization(orgId).approvalSettings.acceptsRequests == true
          && request.resource.data.keys().hasAll(['uid','organizationId','membershipRole','membershipStatus','positionTitle','permissions','applicantName','requestedAt','joinedAt','updatedAt','reviewedAt','reviewedBy'])
          && request.resource.data.keys().hasOnly(['uid','organizationId','membershipRole','membershipStatus','positionTitle','permissions','applicantName','requestedAt','joinedAt','updatedAt','reviewedAt','reviewedBy'])
          && request.resource.data.uid == uid && request.resource.data.organizationId == orgId
          && request.resource.data.membershipRole == 'member' && request.resource.data.membershipStatus == 'pending'
          && request.resource.data.positionTitle == null
          && request.resource.data.permissions is map && request.resource.data.permissions.size() == 0
          && request.resource.data.applicantName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
          && request.resource.data.joinedAt == null && request.resource.data.reviewedAt == null && request.resource.data.reviewedBy == null
          && request.resource.data.requestedAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if manager(orgId) && uid != request.auth.uid && organization(orgId).status == 'active'
          && resource.data.uid == uid && resource.data.organizationId == orgId
          && resource.data.membershipStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membershipStatus','joinedAt','updatedAt','reviewedAt','reviewedBy'])
          && request.resource.data.membershipStatus in ['active','rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time && request.resource.data.updatedAt == request.time
          && ((request.resource.data.membershipStatus == 'active' && request.resource.data.joinedAt == request.time)
            || (request.resource.data.membershipStatus == 'rejected' && request.resource.data.joinedAt == null));
      }
      match /events/{eventId} {
        // Eligibility is checked once at each allow boundary.
        function assignedManager() { return organization(orgId).managerUid == request.auth.uid; }
        function eventOrganizationAccess() {
          return (organization(orgId).visibility == 'public' && organization(orgId).status == 'active')
            || assignedManager() || activeMember(orgId);
        }
        function eventOfficer() {
          return activeMember(orgId)
            && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.membershipRole == 'officer'
            && get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.permissions.get('manageEvents',false) == true;
        }
        function eventEditor(data) { return assignedManager() || (eventOfficer() && data.createdBy == request.auth.uid); }
        function eventVisibility(data) { return data.get('visibility','public'); }
        function visibleEvent(data) {
          return eventOrganizationAccess()
            && (eventVisibility(data) == 'public' || activeMember(orgId) || eventEditor(data));
        }
        function windowOpen(data) {
          return organization(orgId).status == 'active' && data.eventStatus == 'published' && data.approvalStatus == 'approved'
            && request.time < data.registrationDeadline && request.time < data.startAt;
        }
        function withdrawalOpen(data) {
          return data.eventStatus in ['published','cancelled'] && data.approvalStatus == 'approved'
            && request.time < data.registrationDeadline && request.time < data.startAt;
        }
        function joinEligible(data) {
          return windowOpen(data) && eventOrganizationAccess()
            && (eventVisibility(data) == 'public' || activeMember(orgId));
        }
        function validEvent(data) {
          return data.eventId == eventId && data.organizationId == orgId
            && data.title is string && data.title.size() > 0 && data.title.size() <= 200 && data.title.matches('.*[^ ].*')
            && data.description is string && data.description.size() > 0 && data.description.size() <= 5000 && data.description.matches('.*[^ ].*')
            && data.venue is string && data.venue.size() > 0 && data.venue.size() <= 200 && data.venue.matches('.*[^ ].*')
            && data.startAt is timestamp && data.startAt > request.time && data.endAt is timestamp && data.endAt > data.startAt
            && data.registrationDeadline is timestamp && data.registrationDeadline > request.time && data.registrationDeadline <= data.startAt
            && data.capacity is int && data.capacity >= 1 && data.capacity <= 100000
            && data.visibility in ['public','private']
            && (organization(orgId).visibility == 'public' || data.visibility == 'private')
            && (data.posterURL == null || (data.posterURL is string && data.posterURL.size() <= 2048 && data.posterURL.matches('https://.+')));
        }
        function counterChange() {
          let path = /databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/registrations/$(request.auth.uid);
          let previous = exists(path) ? get(path).data.registrationStatus : 'none';
          let after = getAfter(path).data;
          let delta = request.resource.data.registrationCount - resource.data.registrationCount;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount','updatedAt'])
            && request.resource.data.updatedAt == request.time
            && after.uid == request.auth.uid && after.updatedAt == request.time
            && ((delta == 1 && previous in ['none','cancelled'] && after.registrationStatus == 'registered'
                && joinEligible(resource.data) && resource.data.registrationCount < resource.data.capacity)
              || (delta == -1 && withdrawalOpen(resource.data) && previous == 'registered' && after.registrationStatus == 'cancelled' && resource.data.registrationCount > 0));
        }
        function editDraft() {
          return eventEditor(resource.data) && organization(orgId).status == 'active'
            && resource.data.eventStatus == 'draft' && resource.data.get('archivedAt',null) == null
            && !(resource.data.approvalStatus == 'pending' && resource.data.get('submittedAt',null) != null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','posterURL','startAt','endAt','venue','capacity','registrationDeadline','visibility','approvalStatus','submittedAt','updatedAt'])
            && request.resource.data.approvalStatus == 'pending' && request.resource.data.submittedAt == null
            && validEvent(request.resource.data);
        }
        function submitDraft() {
          return eventEditor(resource.data) && organization(orgId).status == 'active' && resource.data.eventStatus == 'draft'
            && (resource.data.approvalStatus == 'rejected' || resource.data.get('submittedAt',null) == null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus','submittedAt','updatedAt'])
            && request.resource.data.approvalStatus == 'pending' && request.resource.data.submittedAt == request.time
            && validEvent(request.resource.data);
        }
        function reviewDraft() {
          return assignedManager() && organization(orgId).status == 'active' && resource.data.eventStatus == 'draft'
            && resource.data.approvalStatus == 'pending' && resource.data.get('submittedAt',null) is timestamp
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus','reviewedAt','reviewedBy','updatedAt'])
            && request.resource.data.approvalStatus in ['approved','rejected']
            && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid;
        }
        function managerTransition() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return assignedManager() && organization(orgId).status == 'active' && resource.data.get('archivedAt',null) == null
            && ((resource.data.eventStatus == 'draft' && resource.data.approvalStatus == 'approved'
                && changed.hasOnly(['eventStatus','publishedAt','updatedAt']) && request.resource.data.eventStatus == 'published'
                && request.resource.data.publishedAt == request.time && validEvent(request.resource.data))
              || (resource.data.eventStatus in ['draft','published'] && changed.hasOnly(['eventStatus','cancelledAt','updatedAt'])
                && request.resource.data.eventStatus == 'cancelled' && request.resource.data.cancelledAt == request.time)
              || (resource.data.eventStatus == 'published' && request.time >= resource.data.endAt
                && changed.hasOnly(['eventStatus','completedAt','updatedAt']) && request.resource.data.eventStatus == 'completed' && request.resource.data.completedAt == request.time)
              || (resource.data.eventStatus in ['completed','cancelled'] && changed.hasOnly(['archivedAt','updatedAt']) && request.resource.data.archivedAt == request.time));
        }
        allow read: if eligible() && (attendanceOperator(orgId) || eventEditor(resource.data)
          || (visibleEvent(resource.data) && ((resource.data.eventStatus in ['published','completed'] && resource.data.approvalStatus == 'approved')
            || (resource.data.eventStatus == 'cancelled' && exists(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/registrations/$(request.auth.uid))))));
        allow create: if eligible() && organization(orgId).status == 'active' && (assignedManager() || eventOfficer())
          && request.resource.data.keys().hasAll(['eventId','organizationId','title','description','posterURL','startAt','endAt','venue','capacity','registrationDeadline','registrationCount','eventStatus','approvalStatus','createdBy','createdAt','updatedAt','visibility','submittedAt','reviewedAt','reviewedBy','publishedAt','cancelledAt','completedAt','archivedAt'])
          && request.resource.data.keys().hasOnly(['eventId','organizationId','title','description','posterURL','startAt','endAt','venue','capacity','registrationDeadline','registrationCount','eventStatus','approvalStatus','createdBy','createdAt','updatedAt','visibility','submittedAt','reviewedAt','reviewedBy','publishedAt','cancelledAt','completedAt','archivedAt'])
          && validEvent(request.resource.data) && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.registrationCount == 0 && request.resource.data.eventStatus == 'draft' && request.resource.data.approvalStatus == 'pending'
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.submittedAt == null && request.resource.data.reviewedAt == null && request.resource.data.reviewedBy == null
          && request.resource.data.publishedAt == null && request.resource.data.cancelledAt == null && request.resource.data.completedAt == null && request.resource.data.archivedAt == null;
        allow update: if eligible() && request.resource.data.updatedAt == request.time
          && ((request.resource.data.registrationCount != resource.data.registrationCount && counterChange())
            || (request.resource.data.registrationCount == resource.data.registrationCount && (editDraft() || submitDraft() || reviewDraft() || managerTransition())));
        match /attendance/{uid} {
          function eventData() { return get(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)).data; }
          function registrationData() { return get(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/registrations/$(uid)).data; }
          allow get: if eligible() && (owner(uid) || attendanceOperator(orgId));
          allow list: if attendanceOperator(orgId);
          allow create: if attendanceOperator(orgId) && organization(orgId).status == 'active'
            && uid != request.auth.uid
            && request.resource.data.keys().hasAll(['uid','eventId','organizationId','attendanceStatus','verifiedAt','verifiedBy','verificationMethod'])
            && request.resource.data.keys().hasOnly(['uid','eventId','organizationId','attendanceStatus','verifiedAt','verifiedBy','verificationMethod'])
            && request.resource.data.uid == uid && request.resource.data.eventId == eventId && request.resource.data.organizationId == orgId
            && request.resource.data.attendanceStatus in ['present','absent']
            && request.resource.data.verificationMethod == 'manual'
            && request.resource.data.verifiedBy == request.auth.uid && request.resource.data.verifiedAt == request.time
            && registrationData().uid == uid && registrationData().eventId == eventId && registrationData().organizationId == orgId
            && registrationData().registrationStatus == 'registered'
            && eventData().eventId == eventId && eventData().organizationId == orgId
            && eventData().eventStatus == 'published' && eventData().approvalStatus == 'approved'
            && eventData().get('publishedAt',null) is timestamp && eventData().get('archivedAt',null) == null
            && request.time >= eventData().startAt && request.time < eventData().endAt;
          // First result is final; QR writes are trusted backend operations only.
        }
        match /participantIdentities/{uid} {
          function registrationAfter() { return getAfter(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/registrations/$(uid)).data; }
          allow read: if eligible() && (attendanceOperator(orgId) || eventEditor(get(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)).data));
          allow create, update: if eligible() && owner(uid)
            && request.resource.data.keys().hasAll(['uid','fullName','updatedAt'])
            && request.resource.data.keys().hasOnly(['uid','fullName','updatedAt'])
            && request.resource.data.uid == uid && request.resource.data.fullName is string
            && request.resource.data.fullName == get(/databases/$(database)/documents/users/$(uid)).data.fullName
            && request.resource.data.updatedAt == request.time
            && registrationAfter().uid == uid && registrationAfter().organizationId == orgId && registrationAfter().eventId == eventId
            && registrationAfter().registrationStatus in ['registered','cancelled'];
        }
        match /registrations/{uid} {
          function eventBefore() { return get(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)).data; }
          function eventAfter() { return getAfter(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)).data; }
          function identityAfter() {
            let identity = getAfter(/databases/$(database)/documents/organizations/$(orgId)/events/$(eventId)/participantIdentities/$(uid)).data;
            return identity.uid == uid && identity.fullName == get(/databases/$(database)/documents/users/$(uid)).data.fullName && identity.updatedAt == request.time;
          }
          function paired(delta) { return eventAfter().registrationCount == eventBefore().registrationCount + delta && eventAfter().updatedAt == request.time; }
          allow get: if eligible() && (owner(uid) || attendanceOperator(orgId) || eventEditor(eventBefore()));
          allow list: if eligible() && (attendanceOperator(orgId) || eventEditor(eventBefore()));
          allow create: if eligible() && owner(uid) && joinEligible(eventBefore()) && eventBefore().registrationCount < eventBefore().capacity
            && request.resource.data.keys().hasAll(['uid','eventId','organizationId','registrationStatus','registeredAt','updatedAt'])
            && request.resource.data.keys().hasOnly(['uid','eventId','organizationId','registrationStatus','registeredAt','updatedAt'])
            && request.resource.data.uid == uid && request.resource.data.eventId == eventId && request.resource.data.organizationId == orgId
            && request.resource.data.registrationStatus == 'registered' && request.resource.data.registeredAt == request.time
            && request.resource.data.updatedAt == request.time && identityAfter() && paired(1);
          allow update: if eligible() && owner(uid) && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationStatus','updatedAt'])
            && ((resource.data.registrationStatus == 'registered' && request.resource.data.registrationStatus == 'cancelled' && withdrawalOpen(eventBefore()) && paired(-1))
              || (resource.data.registrationStatus == 'cancelled' && request.resource.data.registrationStatus == 'registered'
                && joinEligible(eventBefore()) && eventBefore().registrationCount < eventBefore().capacity && identityAfter() && paired(1)));
        }
      }
    }
    // Collection-group queries must filter uid == the authenticated UID.
    match /{path=**}/memberships/{uid} {
      allow list: if eligible() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/registrations/{uid} {
      allow list: if eligible() && resource.data.uid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
